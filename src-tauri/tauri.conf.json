{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PCIE",
  "version": "1.4.6",
  "identifier": "com.med-hermes.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "全医慧助（PCIE）",
        "label": "main",
        "width": 160,
        "height": 160,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "transparent": true,
        "x": 1720,
        "y": 100,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost http: https: ws: wss:",
        "font-src": "'self' data:",
        "frame-src": "http: https:",
        "img-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "shortDescription": "全医慧助（PCIE）基层医疗智能全科专家工作站",
    "longDescription": "Primary Care Intelligent Expert，为基层医生提供智能问诊、病历生成、诊疗建议、报告解读和安全复核辅助。",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "windows": {}
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "med-hermes"
        ]
      }
    },
    "updater": {
      "active": true,
      "dangerous-insecure-transport-protocol": true,
      "endpoints": [
        "https://github.com/yangli216/pcie/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MUE5REVEQkMwOEE0RTgKUldUb3BBaTg3WjBhTk9WREQxN3dlSm1uYklSbGNNZldhbnBpV3Rpb1pscnBVZisxcTNDM08zRncK",
      "windows": {
        "installMode": "passive"
      }
    },
    "allowlist": {
      "updater": {
        "checkUpdate": true,
        "downloadUpdate": true,
        "installUpdate": true
      }
    }
  }
}
